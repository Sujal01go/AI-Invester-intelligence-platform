# ==============================================================================
# InvestIntel AI - Environment Configuration Template
# Copy this file to .env and replace the placeholder values with your credentials
# ==============================================================================

# Azure OpenAI Configuration
AZURE_OPENAI_ENDPOINT=https://<your-resource-name>.openai.azure.com/
AZURE_OPENAI_CHAT_ENDPOINT=https://<your-resource-name>.openai.azure.com/
AZURE_OPENAI_API_KEY=<your-azure-openai-key>
AZURE_OPENAI_API_VERSION=2024-02-15-preview
AZURE_OPENAI_API_EMBEDDING_VERSION=2023-05-15

# Azure OpenAI Model Deployments
AZURE_OPENAI_EMBEDDING_DEPLOYMENT=text-embedding-ada-002
AZURE_OPENAI_CHAT_DEPLOYMENT=gpt-4o

# Azure AI Search Service
AZURE_SEARCH_ENDPOINT=https://<your-search-service-name>.search.windows.net
AZURE_SEARCH_API_KEY=<your-azure-search-admin-key>
AZURE_SEARCH_INDEX_NAME=investor-intelligence-index

# PostgreSQL Database Configuration
POSTGRES_HOST=<your-postgres-host>
POSTGRES_PORT=5432
POSTGRES_DATABASE=investor_intelligence
POSTGRES_USER=<your-postgres-username>
POSTGRES_PASSWORD=<your-postgres-password>

# Application Server Port (Optional, default 8000)
PORT=8000
